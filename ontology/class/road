<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/rtskg/ontology#"
     xml:base="https://w3id.org/rtskg/ontology"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:rtskg="https://w3id.org/rtskg/ontology#">
    <owl:Ontology rdf:about="https://w3id.org/rtskg/ontology">
        <owl:versionIRI rdf:resource="https://w3id.org/rtskg/ontology/1.1"/>
    </owl:Ontology>

    <!-- https://w3id.org/rtskg/ontology/class/road -->

    <owl:Class rdf:about="https://w3id.org/rtskg/ontology/class/road">
        <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
        <rdfs:seeAlso rdf:resource="http://linkedgeodata.org/ontology/HighwayThing"/>
        <rdfs:label>Road</rdfs:label>
        <rdfs:comment xml:lang="en">The road segment in a city.</rdfs:comment>
    </owl:Class>
</rdf:RDF>
