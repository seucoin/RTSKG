    "@value" : "Models the adjacency between two boroughs."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/rtskg/ontology/class/borough"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "borough_is_adjacent_to_borough"
  } ],
