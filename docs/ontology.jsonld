}, {
  "@id" : "https://w3id.org/rtskg/ontology/class/block",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The urban block, which is a fine-grained spatial unit that constitutes the fundamental element of the physical structure of urban areas."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Block"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.opengis.net/ont/geosparql#Feature"
  } ]
}, {
  "@id" : "https://w3id.org/rtskg/ontology/class/borough",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "An administrative borough describing high-level administrative boundaries of a city."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Borough"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.opengis.net/ont/geosparql#Feature"
  } ]
}, {
  "@id" : "https://w3id.org/rtskg/ontology/class/functional_area",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A functional area representing the subdivision of a city according to its function (e.g., residential areas)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Functional Area"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.opengis.net/ont/geosparql#Feature"
  } ]
}, {
  "@id" : "https://w3id.org/rtskg/ontology/class/line",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The rail transit line, which is a sequence of connected stations."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Line"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#seeAlso" : [ {
    "@id" : "http://vocab.gtfs.org/terms#Route"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@language" : "en",
    "@value" : "Rail Transit Line"
  } ]
}, {
  "@id" : "https://w3id.org/rtskg/ontology/class/poi",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A point of interest (POI), which represents the basic functional units in a city."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "POI"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.opengis.net/ont/geosparql#Feature"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@language" : "en",
    "@value" : "Point of Interest"
  } ]
}, {
  "@id" : "https://w3id.org/rtskg/ontology/class/poi_category",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The category of a POI, which characterizes the function of the POI."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "POI Category"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@language" : "en",
    "@value" : "Point of Interest Category"
  } ]
}, {
  "@id" : "https://w3id.org/rtskg/ontology/class/road",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The road segment in a city."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Road"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#seeAlso" : [ {
    "@id" : "http://linkedgeodata.org/ontology/HighwayThing"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.opengis.net/ont/geosparql#Feature"
  } ]
}, {
  "@id" : "https://w3id.org/rtskg/ontology/class/road_category",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The category determined by the hierarchy or function of the road."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Road Category"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  } ]
}, {
  "@id" : "https://w3id.org/rtskg/ontology/class/station",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The rail transit station, which serves as a transport hub for passengers to board or alight from the rail transit vehicles like subway train."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Station"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#seeAlso" : [ {
    "@id" : "http://linkedgeodata.org/ontology/RailwayStation"
  }, {
    "@id" : "http://vocab.gtfs.org/terms#Station"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@language" : "en",
    "@value" : "Rail Transit Station"
  } ]
}, {
  "@id" : "https://w3id.org/rtskg/ontology/class/station_area",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The region accessible from a rail transit station within a specified walking time."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Station Area"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.opengis.net/ont/geosparql#Feature"
  } ]
}, {
  "@id" : "https://w3id.org/rtskg/ontology/dataproperty/geometry",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The geometry of a feature, encoded as an OGC Well-Known Text (WKT) literal in the WGS84 coordinate reference system."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.opengis.net/ont/geosparql#Feature"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "geometry"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.opengis.net/ont/geosparql#wktLiteral"
  } ]
}, {
  "@id" : "https://w3id.org/rtskg/ontology/dataproperty/walking_time_minutes",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The walking time, in minutes, used to construct the station area as the region reachable from a station within this time (e.g., 5 or 10 minutes)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/rtskg/ontology/class/station_area"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "walking_time_minutes"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#integer"
  } ]
}, {
  "@id" : "https://w3id.org/rtskg/ontology/objectproperty/block_intersects_station_area",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Models the intersection between a block and a station area."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/rtskg/ontology/class/block"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "block_intersects_station_area"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/rtskg/ontology/class/station_area"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "http://www.opengis.net/ont/geosparql#sfIntersects"
  } ]
}, {
  "@id" : "https://w3id.org/rtskg/ontology/objectproperty/block_locates_at_borough",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Models the location relation between a block and a borough."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/rtskg/ontology/class/block"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "block_locates_at_borough"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/rtskg/ontology/class/borough"
  } ]
}, {
  "@id" : "https://w3id.org/rtskg/ontology/objectproperty/block_locates_at_functional_area",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Models the location relation between a block and a functional area."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/rtskg/ontology/class/block"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "block_locates_at_functional_area"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/rtskg/ontology/class/functional_area"
  } ]
