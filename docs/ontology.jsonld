  "http://purl.org/dc/terms/description" : [ {
    "@language" : "en",
    "@value" : "The RTSKG ontology is the unified schema of the Rail Transit Station Knowledge Graph (RTSKG), a dataset that explicitly models the spatial and semantic interactions among different kinds of urban entities. It defines ten classes and nineteen relations."
  } ],
  "http://purl.org/dc/terms/license" : [ {
    "@id" : "https://creativecommons.org/licenses/by-sa/4.0/"
  } ],
