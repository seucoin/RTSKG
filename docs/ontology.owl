<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/rtskg/ontology#"
     xml:base="https://w3id.org/rtskg/ontology"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:bibo="http://purl.org/ontology/bibo/"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:schema="http://schema.org/">
    <owl:Ontology rdf:about="https://w3id.org/rtskg/ontology">
        <owl:versionIRI rdf:resource="https://w3id.org/rtskg/ontology/1.1"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#gYearMonth">2025-11</terms:created>
        <terms:creator>Runfeng Liu</terms:creator>
        <terms:creator>Shutong Zhu</terms:creator>
        <terms:creator>Tianxing Wu</terms:creator>
        <terms:creator>Xuan He</terms:creator>
        <terms:creator>Yuan Zhu</terms:creator>
        <terms:creator>Yuang Gu</terms:creator>
        <terms:description xml:lang="en">The RTSKG ontology is the unified schema of the Rail Transit Station Knowledge Graph (RTSKG), a dataset that explicitly models the spatial and semantic interactions among different kinds of urban entities. It defines ten classes and nineteen relations.</terms:description>
        <terms:license rdf:resource="https://creativecommons.org/licenses/by-sa/4.0/"/>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#gYearMonth">2026-06</terms:modified>
        <terms:publisher>Southeast University</terms:publisher>
        <terms:rights xml:lang="en">This ontology is licensed under the Creative Commons Attribution-ShareAlike 4.0 International License (CC BY-SA 4.0).</terms:rights>
        <terms:title xml:lang="en">RTSKG Ontology</terms:title>
        <bibo:status rdf:resource="http://purl.org/ontology/bibo/status/published"/>
        <vann:preferredNamespacePrefix>rtskg</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>https://w3id.org/rtskg/ontology/</vann:preferredNamespaceUri>
        <schema:codeRepository rdf:resource="https://github.com/seucoin/RTSKG"/>
        <rdfs:label xml:lang="en">RTSKG Ontology</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://seucoin.github.io/RTSKG/"/>
        <owl:priorVersion rdf:resource="https://w3id.org/rtskg/ontology/1.0"/>
        <owl:versionInfo>1.1</owl:versionInfo>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/dc/terms/created -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/created"/>
    


    <!-- http://purl.org/dc/terms/creator -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/creator"/>
    


    <!-- http://purl.org/dc/terms/description -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/description"/>
    


    <!-- http://purl.org/dc/terms/license -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/license"/>
    


    <!-- http://purl.org/dc/terms/modified -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/modified"/>
    


    <!-- http://purl.org/dc/terms/publisher -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/publisher"/>
    


    <!-- http://purl.org/dc/terms/rights -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/rights"/>
    


    <!-- http://purl.org/dc/terms/title -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/title"/>
    


    <!-- http://purl.org/ontology/bibo/status -->


    <owl:AnnotationProperty rdf:about="http://purl.org/ontology/bibo/status"/>
    


    <!-- http://purl.org/vocab/vann/preferredNamespacePrefix -->


    <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespacePrefix"/>
    


    <!-- http://purl.org/vocab/vann/preferredNamespaceUri -->


    <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespaceUri"/>
    


    <!-- http://schema.org/codeRepository -->


    <owl:AnnotationProperty rdf:about="http://schema.org/codeRepository"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#altLabel -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#altLabel"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.opengis.net/ont/geosparql#wktLiteral -->


    <rdfs:Datatype rdf:about="http://www.opengis.net/ont/geosparql#wktLiteral">
        <owl:equivalentClass rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </rdfs:Datatype>
    


    <!-- http://www.w3.org/2001/XMLSchema#gYearMonth -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#gYearMonth"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.opengis.net/ont/geosparql#sfIntersects -->


    <owl:ObjectProperty rdf:about="http://www.opengis.net/ont/geosparql#sfIntersects"/>
    


    <!-- http://www.opengis.net/ont/geosparql#sfTouches -->


    <owl:ObjectProperty rdf:about="http://www.opengis.net/ont/geosparql#sfTouches"/>
    


    <!-- https://w3id.org/rtskg/ontology/objectproperty/block_intersects_station_area -->


    <owl:ObjectProperty rdf:about="https://w3id.org/rtskg/ontology/objectproperty/block_intersects_station_area">
        <rdfs:subPropertyOf rdf:resource="http://www.opengis.net/ont/geosparql#sfIntersects"/>
        <rdfs:domain rdf:resource="https://w3id.org/rtskg/ontology/class/block"/>
        <rdfs:range rdf:resource="https://w3id.org/rtskg/ontology/class/station_area"/>
        <rdfs:comment xml:lang="en">Models the intersection between a block and a station area.</rdfs:comment>
        <rdfs:label>block_intersects_station_area</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rtskg/ontology/objectproperty/block_locates_at_borough -->


    <owl:ObjectProperty rdf:about="https://w3id.org/rtskg/ontology/objectproperty/block_locates_at_borough">
        <rdfs:domain rdf:resource="https://w3id.org/rtskg/ontology/class/block"/>
        <rdfs:range rdf:resource="https://w3id.org/rtskg/ontology/class/borough"/>
        <rdfs:comment xml:lang="en">Models the location relation between a block and a borough.</rdfs:comment>
        <rdfs:label>block_locates_at_borough</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rtskg/ontology/objectproperty/block_locates_at_functional_area -->


    <owl:ObjectProperty rdf:about="https://w3id.org/rtskg/ontology/objectproperty/block_locates_at_functional_area">
        <rdfs:domain rdf:resource="https://w3id.org/rtskg/ontology/class/block"/>
        <rdfs:range rdf:resource="https://w3id.org/rtskg/ontology/class/functional_area"/>
        <rdfs:comment xml:lang="en">Models the location relation between a block and a functional area.</rdfs:comment>
        <rdfs:label>block_locates_at_functional_area</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rtskg/ontology/objectproperty/borough_is_adjacent_to_borough -->


    <owl:ObjectProperty rdf:about="https://w3id.org/rtskg/ontology/objectproperty/borough_is_adjacent_to_borough">
        <rdfs:subPropertyOf rdf:resource="http://www.opengis.net/ont/geosparql#sfTouches"/>
        <rdfs:domain rdf:resource="https://w3id.org/rtskg/ontology/class/borough"/>
        <rdfs:range rdf:resource="https://w3id.org/rtskg/ontology/class/borough"/>
        <rdfs:comment xml:lang="en">Models the adjacency between two boroughs.</rdfs:comment>
        <rdfs:label>borough_is_adjacent_to_borough</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rtskg/ontology/objectproperty/functional_area_is_adjacent_to_functional_area -->


    <owl:ObjectProperty rdf:about="https://w3id.org/rtskg/ontology/objectproperty/functional_area_is_adjacent_to_functional_area">
        <rdfs:subPropertyOf rdf:resource="http://www.opengis.net/ont/geosparql#sfTouches"/>
        <rdfs:domain rdf:resource="https://w3id.org/rtskg/ontology/class/functional_area"/>
        <rdfs:range rdf:resource="https://w3id.org/rtskg/ontology/class/functional_area"/>
        <rdfs:comment xml:lang="en">Models the adjacency between two functional areas.</rdfs:comment>
        <rdfs:label>functional_area_is_adjacent_to_functional_area</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rtskg/ontology/objectproperty/functional_area_locates_at_borough -->


    <owl:ObjectProperty rdf:about="https://w3id.org/rtskg/ontology/objectproperty/functional_area_locates_at_borough">
        <rdfs:domain rdf:resource="https://w3id.org/rtskg/ontology/class/functional_area"/>
        <rdfs:range rdf:resource="https://w3id.org/rtskg/ontology/class/borough"/>
        <rdfs:comment xml:lang="en">Models the location relation between a functional area and a borough.</rdfs:comment>
        <rdfs:label>functional_area_locates_at_borough</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rtskg/ontology/objectproperty/poi_has_poi_category -->


    <owl:ObjectProperty rdf:about="https://w3id.org/rtskg/ontology/objectproperty/poi_has_poi_category">
        <rdfs:domain rdf:resource="https://w3id.org/rtskg/ontology/class/poi"/>
        <rdfs:range rdf:resource="https://w3id.org/rtskg/ontology/class/poi_category"/>
        <rdfs:comment xml:lang="en">Models the non-geographic relation in which a POI has a POI category.</rdfs:comment>
        <rdfs:label>poi_has_poi_category</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rtskg/ontology/objectproperty/poi_locates_at_block -->


    <owl:ObjectProperty rdf:about="https://w3id.org/rtskg/ontology/objectproperty/poi_locates_at_block">
        <rdfs:domain rdf:resource="https://w3id.org/rtskg/ontology/class/poi"/>
        <rdfs:range rdf:resource="https://w3id.org/rtskg/ontology/class/block"/>
        <rdfs:comment xml:lang="en">Models the location relation between a POI and a block.</rdfs:comment>
        <rdfs:label>poi_locates_at_block</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rtskg/ontology/objectproperty/poi_locates_at_station_area -->


    <owl:ObjectProperty rdf:about="https://w3id.org/rtskg/ontology/objectproperty/poi_locates_at_station_area">
        <rdfs:domain rdf:resource="https://w3id.org/rtskg/ontology/class/poi"/>
        <rdfs:range rdf:resource="https://w3id.org/rtskg/ontology/class/station_area"/>
        <rdfs:comment xml:lang="en">Models the location relation between a POI and a station area.</rdfs:comment>
        <rdfs:label>poi_locates_at_station_area</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rtskg/ontology/objectproperty/road_has_road_category -->


    <owl:ObjectProperty rdf:about="https://w3id.org/rtskg/ontology/objectproperty/road_has_road_category">
        <rdfs:domain rdf:resource="https://w3id.org/rtskg/ontology/class/road"/>
        <rdfs:range rdf:resource="https://w3id.org/rtskg/ontology/class/road_category"/>
        <rdfs:comment xml:lang="en">Models the non-geographic relation in which a road has a road category.</rdfs:comment>
        <rdfs:label>road_has_road_category</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rtskg/ontology/objectproperty/road_intersects_borough -->


    <owl:ObjectProperty rdf:about="https://w3id.org/rtskg/ontology/objectproperty/road_intersects_borough">
        <rdfs:subPropertyOf rdf:resource="http://www.opengis.net/ont/geosparql#sfIntersects"/>
        <rdfs:domain rdf:resource="https://w3id.org/rtskg/ontology/class/road"/>
        <rdfs:range rdf:resource="https://w3id.org/rtskg/ontology/class/borough"/>
        <rdfs:comment xml:lang="en">Models the intersection between a road and a borough.</rdfs:comment>
        <rdfs:label>road_intersects_borough</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rtskg/ontology/objectproperty/road_intersects_functional_area -->


    <owl:ObjectProperty rdf:about="https://w3id.org/rtskg/ontology/objectproperty/road_intersects_functional_area">
        <rdfs:subPropertyOf rdf:resource="http://www.opengis.net/ont/geosparql#sfIntersects"/>
        <rdfs:domain rdf:resource="https://w3id.org/rtskg/ontology/class/road"/>
        <rdfs:range rdf:resource="https://w3id.org/rtskg/ontology/class/functional_area"/>
        <rdfs:comment xml:lang="en">Models the intersection between a road and a functional area.</rdfs:comment>
        <rdfs:label>road_intersects_functional_area</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rtskg/ontology/objectproperty/road_intersects_station_area -->


    <owl:ObjectProperty rdf:about="https://w3id.org/rtskg/ontology/objectproperty/road_intersects_station_area">
        <rdfs:subPropertyOf rdf:resource="http://www.opengis.net/ont/geosparql#sfIntersects"/>
        <rdfs:domain rdf:resource="https://w3id.org/rtskg/ontology/class/road"/>
        <rdfs:range rdf:resource="https://w3id.org/rtskg/ontology/class/station_area"/>
        <rdfs:comment xml:lang="en">Models the intersection between a road and a station area.</rdfs:comment>
        <rdfs:label>road_intersects_station_area</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rtskg/ontology/objectproperty/station_area_belongs_to_station -->


    <owl:ObjectProperty rdf:about="https://w3id.org/rtskg/ontology/objectproperty/station_area_belongs_to_station">
        <rdfs:domain rdf:resource="https://w3id.org/rtskg/ontology/class/station_area"/>
        <rdfs:range rdf:resource="https://w3id.org/rtskg/ontology/class/station"/>
        <rdfs:comment xml:lang="en">Models the non-geographic relation in which a station area belongs to a station.</rdfs:comment>
        <rdfs:label>station_area_belongs_to_station</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rtskg/ontology/objectproperty/station_area_intersects_block -->


    <owl:ObjectProperty rdf:about="https://w3id.org/rtskg/ontology/objectproperty/station_area_intersects_block">
        <rdfs:subPropertyOf rdf:resource="http://www.opengis.net/ont/geosparql#sfIntersects"/>
        <rdfs:domain rdf:resource="https://w3id.org/rtskg/ontology/class/station_area"/>
        <rdfs:range rdf:resource="https://w3id.org/rtskg/ontology/class/block"/>
        <rdfs:comment xml:lang="en">Models the intersection between a station area and a block.</rdfs:comment>
        <rdfs:label>station_area_intersects_block</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rtskg/ontology/objectproperty/station_area_intersects_station_area -->


    <owl:ObjectProperty rdf:about="https://w3id.org/rtskg/ontology/objectproperty/station_area_intersects_station_area">
        <rdfs:subPropertyOf rdf:resource="http://www.opengis.net/ont/geosparql#sfIntersects"/>
        <rdfs:domain rdf:resource="https://w3id.org/rtskg/ontology/class/station_area"/>
        <rdfs:range rdf:resource="https://w3id.org/rtskg/ontology/class/station_area"/>
        <rdfs:comment xml:lang="en">Models the intersection between two station areas.</rdfs:comment>
        <rdfs:label>station_area_intersects_station_area</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rtskg/ontology/objectproperty/station_area_locates_at_borough -->


    <owl:ObjectProperty rdf:about="https://w3id.org/rtskg/ontology/objectproperty/station_area_locates_at_borough">
        <rdfs:domain rdf:resource="https://w3id.org/rtskg/ontology/class/station_area"/>
        <rdfs:range rdf:resource="https://w3id.org/rtskg/ontology/class/borough"/>
        <rdfs:comment xml:lang="en">Models the location relation between a station area and a borough.</rdfs:comment>
        <rdfs:label>station_area_locates_at_borough</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rtskg/ontology/objectproperty/station_area_locates_at_functional_area -->


    <owl:ObjectProperty rdf:about="https://w3id.org/rtskg/ontology/objectproperty/station_area_locates_at_functional_area">
        <rdfs:domain rdf:resource="https://w3id.org/rtskg/ontology/class/station_area"/>
        <rdfs:range rdf:resource="https://w3id.org/rtskg/ontology/class/functional_area"/>
        <rdfs:comment xml:lang="en">Models the location relation between a station area and a functional area.</rdfs:comment>
        <rdfs:label>station_area_locates_at_functional_area</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/rtskg/ontology/objectproperty/station_belongs_to_line -->


    <owl:ObjectProperty rdf:about="https://w3id.org/rtskg/ontology/objectproperty/station_belongs_to_line">
        <rdfs:domain rdf:resource="https://w3id.org/rtskg/ontology/class/station"/>
        <rdfs:range rdf:resource="https://w3id.org/rtskg/ontology/class/line"/>
        <rdfs:comment xml:lang="en">Models the non-geographic relation in which a station belongs to a rail transit line.</rdfs:comment>
        <rdfs:label>station_belongs_to_line</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/rtskg/ontology/dataproperty/geometry -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/rtskg/ontology/dataproperty/geometry">
        <rdfs:domain rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
        <rdfs:range rdf:resource="http://www.opengis.net/ont/geosparql#wktLiteral"/>
        <rdfs:comment xml:lang="en">The geometry of a feature, encoded as an OGC Well-Known Text (WKT) literal in the WGS84 coordinate reference system.</rdfs:comment>
        <rdfs:label>geometry</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/rtskg/ontology/dataproperty/walking_time_minutes -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/rtskg/ontology/dataproperty/walking_time_minutes">
        <rdfs:domain rdf:resource="https://w3id.org/rtskg/ontology/class/station_area"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="en">The walking time, in minutes, used to construct the station area as the region reachable from a station within this time (e.g., 5 or 10 minutes).</rdfs:comment>
        <rdfs:label>walking_time_minutes</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.opengis.net/ont/geosparql#Feature -->


    <owl:Class rdf:about="http://www.opengis.net/ont/geosparql#Feature"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#Concept -->


    <owl:Class rdf:about="http://www.w3.org/2004/02/skos/core#Concept"/>
    


    <!-- https://w3id.org/rtskg/ontology/class/block -->


    <owl:Class rdf:about="https://w3id.org/rtskg/ontology/class/block">
        <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
        <rdfs:comment xml:lang="en">The urban block, which is a fine-grained spatial unit that constitutes the fundamental element of the physical structure of urban areas.</rdfs:comment>
        <rdfs:label>Block</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rtskg/ontology/class/borough -->


    <owl:Class rdf:about="https://w3id.org/rtskg/ontology/class/borough">
        <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
        <rdfs:comment xml:lang="en">An administrative borough describing high-level administrative boundaries of a city.</rdfs:comment>
        <rdfs:label>Borough</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rtskg/ontology/class/functional_area -->


    <owl:Class rdf:about="https://w3id.org/rtskg/ontology/class/functional_area">
        <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
        <rdfs:comment xml:lang="en">A functional area representing the subdivision of a city according to its function (e.g., residential areas).</rdfs:comment>
        <rdfs:label>Functional Area</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rtskg/ontology/class/line -->


    <owl:Class rdf:about="https://w3id.org/rtskg/ontology/class/line">
        <rdfs:comment xml:lang="en">The rail transit line, which is a sequence of connected stations.</rdfs:comment>
        <rdfs:label>Line</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://vocab.gtfs.org/terms#Route"/>
        <skos:altLabel xml:lang="en">Rail Transit Line</skos:altLabel>
    </owl:Class>
    


    <!-- https://w3id.org/rtskg/ontology/class/poi -->


    <owl:Class rdf:about="https://w3id.org/rtskg/ontology/class/poi">
        <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
        <rdfs:comment xml:lang="en">A point of interest (POI), which represents the basic functional units in a city.</rdfs:comment>
        <rdfs:label>POI</rdfs:label>
        <skos:altLabel xml:lang="en">Point of Interest</skos:altLabel>
    </owl:Class>
    


    <!-- https://w3id.org/rtskg/ontology/class/poi_category -->


    <owl:Class rdf:about="https://w3id.org/rtskg/ontology/class/poi_category">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">The category of a POI, which characterizes the function of the POI.</rdfs:comment>
        <rdfs:label>POI Category</rdfs:label>
        <skos:altLabel xml:lang="en">Point of Interest Category</skos:altLabel>
    </owl:Class>
    


    <!-- https://w3id.org/rtskg/ontology/class/road -->


    <owl:Class rdf:about="https://w3id.org/rtskg/ontology/class/road">
        <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
        <rdfs:comment xml:lang="en">The road segment in a city.</rdfs:comment>
        <rdfs:label>Road</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://linkedgeodata.org/ontology/HighwayThing"/>
    </owl:Class>
    


    <!-- https://w3id.org/rtskg/ontology/class/road_category -->


    <owl:Class rdf:about="https://w3id.org/rtskg/ontology/class/road_category">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">The category determined by the hierarchy or function of the road.</rdfs:comment>
        <rdfs:label>Road Category</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/rtskg/ontology/class/station -->


    <owl:Class rdf:about="https://w3id.org/rtskg/ontology/class/station">
