                                                        rdfs:label "geometry" .


###  https://w3id.org/rtskg/ontology/dataproperty/walking_time_minutes
<https://w3id.org/rtskg/ontology/dataproperty/walking_time_minutes> rdf:type owl:DatatypeProperty ;
                                                                    rdfs:domain <https://w3id.org/rtskg/ontology/class/station_area> ;
                                                                    rdfs:range xsd:integer ;
                                                                    rdfs:comment "The walking time, in minutes, used to construct the station area as the region reachable from a station within this time (e.g., 5 or 10 minutes)."@en ;
                                                                    rdfs:label "walking_time_minutes" .


