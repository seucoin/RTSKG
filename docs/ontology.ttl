<http://www.w3.org/2004/02/skos/core#Concept> rdf:type owl:Class .


###  https://w3id.org/rtskg/ontology/class/block
<https://w3id.org/rtskg/ontology/class/block> rdf:type owl:Class ;
                                              rdfs:subClassOf <http://www.opengis.net/ont/geosparql#Feature> ;
                                              rdfs:comment "The urban block, which is a fine-grained spatial unit that constitutes the fundamental element of the physical structure of urban areas."@en ;
                                              rdfs:label "Block" .


###  https://w3id.org/rtskg/ontology/class/borough
<https://w3id.org/rtskg/ontology/class/borough> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://www.opengis.net/ont/geosparql#Feature> ;
                                                rdfs:comment "An administrative borough describing high-level administrative boundaries of a city."@en ;
                                                rdfs:label "Borough" .


###  https://w3id.org/rtskg/ontology/class/functional_area
<https://w3id.org/rtskg/ontology/class/functional_area> rdf:type owl:Class ;
                                                        rdfs:subClassOf <http://www.opengis.net/ont/geosparql#Feature> ;
                                                        rdfs:comment "A functional area representing the subdivision of a city according to its function (e.g., residential areas)."@en ;
                                                        rdfs:label "Functional Area" .


###  https://w3id.org/rtskg/ontology/class/line
<https://w3id.org/rtskg/ontology/class/line> rdf:type owl:Class ;
                                             rdfs:comment "The rail transit line, which is a sequence of connected stations."@en ;
                                             rdfs:label "Line" ;
                                             rdfs:seeAlso <http://vocab.gtfs.org/terms#Route> ;
                                             <http://www.w3.org/2004/02/skos/core#altLabel> "Rail Transit Line"@en .


###  https://w3id.org/rtskg/ontology/class/poi
<https://w3id.org/rtskg/ontology/class/poi> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://www.opengis.net/ont/geosparql#Feature> ;
                                            rdfs:comment "A point of interest (POI), which represents the basic functional units in a city."@en ;
                                            rdfs:label "POI" ;
                                            <http://www.w3.org/2004/02/skos/core#altLabel> "Point of Interest"@en .


###  https://w3id.org/rtskg/ontology/class/poi_category
<https://w3id.org/rtskg/ontology/class/poi_category> rdf:type owl:Class ;
                                                     rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept> ;
                                                     rdfs:comment "The category of a POI, which characterizes the function of the POI."@en ;
                                                     rdfs:label "POI Category" ;
                                                     <http://www.w3.org/2004/02/skos/core#altLabel> "Point of Interest Category"@en .


###  https://w3id.org/rtskg/ontology/class/road
<https://w3id.org/rtskg/ontology/class/road> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://www.opengis.net/ont/geosparql#Feature> ;
                                             rdfs:comment "The road segment in a city."@en ;
                                             rdfs:label "Road" ;
                                             rdfs:seeAlso <http://linkedgeodata.org/ontology/HighwayThing> .


###  https://w3id.org/rtskg/ontology/class/road_category
<https://w3id.org/rtskg/ontology/class/road_category> rdf:type owl:Class ;
                                                      rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept> ;
                                                      rdfs:comment "The category determined by the hierarchy or function of the road."@en ;
                                                      rdfs:label "Road Category" .


###  https://w3id.org/rtskg/ontology/class/station
<https://w3id.org/rtskg/ontology/class/station> rdf:type owl:Class ;
                                                rdfs:comment "The rail transit station, which serves as a transport hub for passengers to board or alight from the rail transit vehicles like subway train."@en ;
                                                rdfs:label "Station" ;
                                                rdfs:seeAlso <http://linkedgeodata.org/ontology/RailwayStation> ,
                                                             <http://vocab.gtfs.org/terms#Station> ;
                                                <http://www.w3.org/2004/02/skos/core#altLabel> "Rail Transit Station"@en .


###  https://w3id.org/rtskg/ontology/class/station_area
<https://w3id.org/rtskg/ontology/class/station_area> rdf:type owl:Class ;
                                                     rdfs:subClassOf <http://www.opengis.net/ont/geosparql#Feature> ;
                                                     rdfs:comment "The region accessible from a rail transit station within a specified walking time."@en ;
                                                     rdfs:label "Station Area" .


